<!ELEMENT sistema_usuarios (roles, usuarios)>
<!ATTLIST sistema_usuarios
  empresa CDATA #REQUIRED
  fecha_generacion CDATA #REQUIRED
>

<!ELEMENT roles (rol+)>
<!ELEMENT rol (descripcion)>
<!ATTLIST rol
  id ID #REQUIRED
  nombre CDATA #REQUIRED
  nivel (basico|medio|alto) #REQUIRED
>
<!ELEMENT descripcion (#PCDATA)>

<!ELEMENT usuarios (usuario+)>
<!ELEMENT usuario (nombre, apellidos, email, telefono?, departamento, ultimo_acceso?, permisos)>
<!ATTLIST usuario
  id ID #REQUIRED
  rol IDREF #REQUIRED
  estado (activo|inactivo|bloqueado) #REQUIRED
>

<!ELEMENT nombre (#PCDATA)>
<!ELEMENT apellidos (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT telefono (#PCDATA)>
<!ELEMENT departamento (#PCDATA)>
<!ELEMENT ultimo_acceso (#PCDATA)>

<!ELEMENT permisos (permiso+)>
<!ELEMENT permiso (#PCDATA)>
<!ATTLIST permiso
  tipo (lectura|escritura|administracion) #REQUIRED
>
